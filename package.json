{
  "name": "midnight-private-allowlist",
  "version": "1.0.0",
  "description": "Private Allowlist Access — prove Merkle-tree membership and claim access without revealing your identity. Built on Midnight Network.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode preprod && cp -r managed/allowlist/keys dist/keys && cp -r managed/allowlist/zkir dist/zkir",
    "build:preview": "vite build --mode preview && cp -r managed/allowlist/keys dist/keys && cp -r managed/allowlist/zkir dist/zkir",
    "preview": "vite preview",
    "compile": "compact compile contracts/allowlist.compact managed/allowlist",
    "compile:age-gate": "compact compile contracts/age-gate.compact managed/age-gate",
    "compile:counter": "compact compile contracts/counter.compact managed/counter",
    "deploy:preprod": "npx tsx src/deploy-allowlist.ts --network preprod",
    "deploy:preview": "npx tsx src/deploy-allowlist.ts --network preview",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/",
    "test:run": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/ --forceExit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "//overrides": "onchain-runtime-v3 ships a WASM module whose StateValue class is instance-checked across package boundaries. compact-runtime allows ^3.0.0 (resolves to 3.1.0) while midnight-js-protocol pins exactly 3.0.0, so npm installs BOTH — two WASM instances, and any StateValue built by one is rejected by the other with 'expected instance of StateValue'. Pin to the version midnight-js-protocol requires so only one copy is ever loaded.",
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy",
    "compact"
  ]
}
